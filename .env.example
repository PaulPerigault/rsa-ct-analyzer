# Copy to .env (git-ignored). Every value below is optional: the defaults work
# locally with the simulated log started by `task demo` or `rsa-ct-analyzer mock-log`.
# CLI flags always override these variables.

# CT log read by `crawl`. Default: the local simulated log.
# Public example: https://oak.ct.letsencrypt.org/2026h2 (be polite: keep the rate low).
RSA_CT_LOG_URL=http://127.0.0.1:8080

# Max requests per second sent to the log (0 = unlimited).
RSA_CT_RATE_LIMIT=5

# Per-request timeout (Go duration).
RSA_CT_TIMEOUT=30s

# Listen address of `mock-log`. Stays on loopback unless you change it on purpose.
RSA_CT_MOCK_ADDR=127.0.0.1:8080
